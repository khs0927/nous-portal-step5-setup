# ── 시크릿 · 인증 (절대 커밋 금지) ─────────────────────────────
# Hermes OAuth 토큰 파일 (access_token / refresh_token / agent_key 포함)
auth.json
auth.json.*
*.auth.json

# 환경 변수 파일
.env
.env.*

# ── Python ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.pytest_cache/

# ── 로그 ───────────────────────────────────────────────────────
*.log

# ── OS 생성 파일 ───────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── 에디터 ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp

# ── Node ───────────────────────────────────────────────────────
node_modules/

# ── 임시 파일 ──────────────────────────────────────────────────
*.tmp
*.bak
*~

# 참고: docs/, probes/, scripts/, config.yaml.sanitized는 추적 대상이므로
# 위에서 제외하지 않습니다.
